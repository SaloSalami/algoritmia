Algoritmo tiempolmphabitacion
	Definir Limpiarescritorio, tendercama, barrercuarto, totaltiempo Como Entero
	Escribir 'cuanto tardas en ordenar tu escritorio? (en minutos)'
	Leer Limpiarescritorio
	Escribir 'cuanto tardas en tender la cama?'
	Leer tendercama
	Escribir 'cuanto tardas en barrer el cuarto?'
	Leer barrercuarto
	totaltiempo <- Limpiarescritorio+tendercama+barrercuarto
	Escribir 'limpiar el cuarto completo te tomara un tiempo total de ', totaltiempo, ' minutos'
FinAlgoritmo
