Algoritmo prepararbatido
	
	Definir mlleche, mljugo, totalliquido Como Real
	
	Escribir "Ingresa la cantidad de leche que vas a utilizar (ml)"
	Leer mlleche
	
	Escribir "ingresa la cantidad de jugo que agregaras"
	leer mljugo
	
	totalliquido <- mlleche + mljugo
	
	Escribir "el batido tendra un volumen total de ", totalliquido, "ml"
	
	
	
	
	
FinAlgoritmo
